<?xml version="1.0" encoding="utf-8"?>
<PackageManifest Version="2.0.0" xmlns="http://schemas.microsoft.com/developer/vsx-schema/2011">
  <Metadata>
    <Identity Id="CompanyCodeAgent.VisualStudio" Version="0.1.1" Language="tr-TR" Publisher="YourCompany" />
    <DisplayName>Company Code Agent</DisplayName>
    <Description xml:space="preserve">Şirket içi LLM ile çalışan güvenli Visual Studio coding agent.</Description>
    <Installation InstalledByMsi="false" />
  </Metadata>
  <Installation>
    <InstallationTarget Id="Microsoft.VisualStudio.Community" Version="[17.0, 19.0)">
      <ProductArchitecture>amd64</ProductArchitecture>
    </InstallationTarget>
  </Installation>
  <Dependencies>
    <Dependency Id="Microsoft.Framework.NDP" DisplayName=".NET Framework 4.7.2" d:Source="Manual" d:Name=".NET Framework" Version="[4.7.2,)" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011" />
  </Dependencies>
  <Prerequisites>
    <Prerequisite Id="Microsoft.VisualStudio.Component.CoreEditor" Version="[17.0, 19.0)" DisplayName="Visual Studio core editor" />
  </Prerequisites>
  <Assets>
    <Asset Type="Microsoft.VisualStudio.VsPackage" d:Source="Project" d:ProjectName="%CurrentProject%" Path="|%CurrentProject%;PkgdefProjectOutputGroup|" xmlns:d="http://schemas.microsoft.com/developer/vsx-schema-design/2011" />
  </Assets>
</PackageManifest>
